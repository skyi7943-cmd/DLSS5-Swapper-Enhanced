{
  "name": "skyi-dlss-enhanced",
  "version": "2.3.0-community.1",
  "description": "Independent community DLSS configuration manager; experimental integrations require user-supplied runtimes",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:ui": "electron scripts/test-game-filters-ui.js",
    "test:payload": "node scripts/test-feeder-payload.js",
    "test:optiscaler": "node scripts/test-optiscaler-payload.js",
    "payload": "node scripts/collect-payload.js",
    "prebuild": "node scripts/release-guard.js",
    "build": "electron-builder --win --publish never",
    "build:linux": "electron-builder --linux AppImage deb --publish never",
    "icon": "electron scripts/make-icon.js",
    "build:portable": "electron-builder --win portable --publish never",
    "overlay:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-overlay.ps1",
    "overlay:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-overlay.ps1"
  },
  "author": "skyi7943-cmd and community contributors",
  "license": "MIT",
  "dependencies": {
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.skyi7943cmd.dlssenhanced",
    "productName": "Skyi DLSS Enhanced",
    "files": [
      "main.js",
      "preload.js",
      "overlay-preload.js",
      "THIRD_PARTY_NOTICES.md",
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "!**/*.{dll,exe,asi,addon,addon32,addon64,zip,7z,onnx,safetensors}",
      "!assets/logo*.png",
      "!src/renderer/support-*",
      "!src/renderer/icon.png"
    ],
    "extraResources": [],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/community.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "maintainer": "skyi7943-cmd and community contributors",
      "icon": "src/renderer/community-icon.png",
      "artifactName": "Skyi-DLSS-Enhanced-${version}-${arch}.${ext}"
    },
    "compression": "normal",
    "portable": {
      "artifactName": "Skyi-DLSS-Enhanced-${version}-portable.exe",
      "unpackDirName": "Skyi-DLSS-Enhanced"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Skyi DLSS Enhanced",
      "installerIcon": "build/community.ico",
      "uninstallerIcon": "build/community.ico",
      "installerHeaderIcon": "build/community.ico",
      "deleteAppDataOnUninstall": true,
      "artifactName": "Skyi-DLSS-Enhanced-Setup-${version}.exe",
      "include": "build/installer.nsh"
    },
    "beforePack": "./scripts/release-guard.js",
    "publish": null,
    "afterPack": "./scripts/verify-packaged-resources.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/skyi7943-cmd/DLSS5-Swapper-Enhanced.git"
  },
  "homepage": "https://github.com/skyi7943-cmd/DLSS5-Swapper-Enhanced",
  "bugs": {
    "url": "https://github.com/skyi7943-cmd/DLSS5-Swapper-Enhanced/issues"
  }
}
